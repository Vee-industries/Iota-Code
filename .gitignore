# User state (per-session) — NEVER COMMIT
# last_session.json contains the user's hf_token among other session state.
last_session.json
.iota_*

# Smoke-test outputs
smoke_test/

# Local audit trail (preserved on disk; not for distribution)
attic/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Working data (large, regenerable from runs)
data/*
data_archive_*/
*.npy
*.npz

# Surgical exception: paper-referenced analysis outputs (small JSONs the
# papers promise are bundled with the repo release). Walk the tree one
# level at a time so unrelated siblings stay ignored.
!data/paper/
data/paper/*
!data/paper/behavioral_trial_response/
data/paper/behavioral_trial_response/*
!data/paper/behavioral_trial_response/run_0061_jolt_carryover_analysis.json
!data/paper/behavioral_trial_response/run_0061_jolt_carryover_analysis_r0060.json

# Local virtualenvs / IDE
.venv/
.env
.vscode/
.idea/

# OS noise
Thumbs.db
.DS_Store

# Generated logs
*.log
